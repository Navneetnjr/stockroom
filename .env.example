# Copy this file to .env and adjust the values for your machine.
# .env is ignored by git: never commit real passwords.
#
# Port 5433 is the "db" service from docker-compose.yml
# (start it alone with: docker compose up db)

# Database the app uses when you run it
DATABASE_URL=postgresql+psycopg://stockroom:stockroom@127.0.0.1:5433/stockroom

# Separate database used only by the tests (tests may wipe it)
TEST_DATABASE_URL=postgresql+psycopg://stockroom:stockroom@127.0.0.1:5433/stockroom_test
